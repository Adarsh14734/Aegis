{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aegis",
  "version": "0.6.0",
  "identifier": "industries.aeon.aegis",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && rm -rf ../aegis/__pycache__"
  },
  "app": {
    "windows": [
      {
        "title": "Aegis",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "maximizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Light",
        "minimizable": true,
        "closable": true,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "../../aegis": "aegis"
    }
  }
}
